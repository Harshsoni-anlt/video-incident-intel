# Vision model — pick one
VISION_PROVIDER=gemini          # gemini | ollama

# Gemini free tier (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Fully offline alternative — ollama pull moondream
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=moondream

# Text LLM for composing answers (same free tier as project 1)
GROQ_API_KEY=your-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile

# Frame sampling
SAMPLE_FPS=1
MOTION_THRESHOLD=0.02
