# --- Vision provider --------------------------------------------------------
VISION_PROVIDER=gemini          # gemini | ollama

# Free tier, no credit card: https://aistudio.google.com/apikey
# GOOGLE_API_KEY is also accepted, since that is what Google's own tools set.
GEMINI_API_KEY=your-key-here

# Flash-Lite is the cheapest model that reads frames well. Vision and the text
# answers both use it, so there is only one key to manage.
VISION_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001

# 66 tokens per frame instead of 258. Raise to MEDIA_RESOLUTION_MEDIUM if the
# model is missing small details in your footage.
MEDIA_RESOLUTION=MEDIA_RESOLUTION_LOW

# --- Fully offline alternative ----------------------------------------------
# ollama pull moondream   (slower, no batching, no embeddings — keyword search)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=moondream

# --- Sampling and filtering: the cost levers --------------------------------
# Frames per second to look at. CCTV at 30fps is 30x more than anyone needs.
SAMPLE_FPS=1
# Mean pixel change (0-1) below which a frame counts as "nothing happened" and
# never leaves this machine. Raise it to spend less, lower it to miss less.
MOTION_THRESHOLD=0.02
# Hard ceiling on frames sent per video, whatever the filter decides.
MAX_FRAMES=400
# Frames packed into one vision request. The free tier caps requests per day
# far harder than tokens, so batching is what makes long footage affordable.
FRAMES_PER_CALL=12

MAX_UPLOAD_MB=500

# --- Optional: write findings into WarehouseOps AI ---------------------------
# Point at that project's SQLite file and camera findings show up in its
# safety-incident table. Leave empty to disable.
# WAREHOUSE_DB_PATH=../warehouse-ops-agent/data/warehouse.db

# Analyse one clip automatically on first run so the app opens with a working
# dashboard instead of an empty one. Costs a single API call. Set to 0 to start
# clean. If you have run scripts/fetch_sample.py the real footage is used;
# otherwise a synthetic clip is generated locally.
SEED_DEMO=1
